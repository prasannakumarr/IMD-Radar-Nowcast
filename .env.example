# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Real environment variables always win over .env, so this file is a
# developer convenience and can never shadow production config.

# --- Basemap. First one fully configured wins: Mapbox, then CARTO, then a
# --- keyless Esri fallback so the map still works with no credentials at all.

# Mapbox. Use a PUBLIC token (pk.*) -- it ships in client HTML, so never an
# sk.* secret token. Restrict it by URL in the Mapbox dashboard before you
# publish. MAPBOX_STYLE is username/styleid of a published *classic* style;
# the modern Mapbox Standard style is vector-only and cannot be served as
# raster tiles to Leaflet.
MAPBOX_TOKEN=
MAPBOX_STYLE=

# CARTO basemap key. Also public, also rate-limited, also worth restricting.
CARTO_KEY=

# Port for the local server. The server binds all interfaces, so this port is
# reachable from your LAN -- see SECURITY.md.
PORT=8080

# How often to re-fetch from IMD. The radars only produce a new scan every
# 10-25 minutes, so anything below ~600 is wasted load on mausam.imd.gov.in.
REFRESH_SECONDS=600

# Pins on the map, as Name:lat:lon,Name:lat:lon. The first entry is also the
# initial map centre. Unset falls back to city-scale Chennai landmarks.
#
# Privacy note: this is config precisely so that your own neighbourhood stays
# in your .env and out of the repository. Three decimals (~100 m) is plenty
# for a radar map; six decimals is a doorstep.
PLACES=
